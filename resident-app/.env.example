# Backend API URL (use local IP e.g. http://192.168.1.X:5000/api if running on a physical phone)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Client-safe Firebase Web Configuration for Resident Phone Authentication
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAEXAMPLE_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=vendiconnect.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=vendiconnect
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=vendiconnect.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1003722302292
EXPO_PUBLIC_FIREBASE_APP_ID=1:1003722302292:web:example

# Optional development mode toggle (bypasses Firebase SMS limits when testing in sandbox)
EXPO_PUBLIC_DEV_MODE=true
